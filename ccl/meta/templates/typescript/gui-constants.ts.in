{% include ../cclfileheader.in %}

{% for constant in constants %}
{% if constant.brief %}
/** {{ constant.brief | sentence }} */
{% endif %}
export const {{ constant.name }} = {{ constant.value | tsvalue }};

{% endfor %}
{% for enum in enums %}
/////////////////////////////////////////////////////////////////////////////////////////
// {{ enum.name }}
/////////////////////////////////////////////////////////////////////////////////////////

{% for enumerator in enum.enumerators %}
{% if enumerator.brief %}
export const {{ enumerator.name | identifier }} = {{ enumerator.value }}; // {{ enumerator.brief }}
{% else %}
export const {{ enumerator.name | identifier }} = {{ enumerator.value }};
{% endif %}
{% endfor %}

{% endfor %}

