			"name": "ApplicationType",
			"enumerators":
			[
				{
					"name": "kApplicationTypeDesktop",
					"type": "int",
					"value": "0",
					"brief": "desktop application"
				},
				{
					"name": "kApplicationTypeMobile",
					"type": "int",
					"value": "1",
					"brief": "mobile application"
				}
			]
		},
		{
			"name": "AnimationTimingType",
			"brief": "Animation timing types",
			"enumerators":
			[
				{
					"name": "kAnimationTimingTypeLinear",
					"type": "int",
					"function":
					{
						"name": "fourcc",
						"args":
						[
							"linr"
						]
					},
					"brief": "constant speed from start to end"
				},
				{
					"name": "kAnimationTimingTypeToggle",
