						[
							"eain"
						]
					},
					"brief": "slower start"
				},
				{
					"name": "kAnimationTimingTypeEaseOut",
					"type": "int",
					"function":
					{
						"name": "fourcc",
						"args":
						[
							"eaou"
						]
					},
					"brief": "slower end"
				},
				{
					"name": "kAnimationTimingTypeEaseInOut",
					"type": "int",
					"function":
					{
						"name": "fourcc",
						"args":
						[
							"eaio"
						]
					},
					"brief": "slower start and end"
				},
				{
					"name": "kAnimationTimingTypeCubicBezier",
					"type": "int",
					"function":
					{
						"name": "fourcc",
						"args":
						[
							"cubb"
						]
					},
					"brief": "cubic bezier timing"
				}
			]
		},
		{
			"name": "DragSessionDropResult",
