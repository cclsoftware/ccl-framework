					"expression": true,
					"brief": "no effect"
				},
				{
					"name": "kDragSessionDropResultCopyShared",
					"value": "1<<0",
					"type": "int",
					"expression": true,
					"brief": "drop causes a copy that share the data"
				},
				{
					"name": "kDragSessionDropResultCopyReal",
					"value": "1<<1",
					"type": "int",
					"expression": true,
					"brief": "drop causes a complete copy"
				},
				{
					"name": "kDragSessionDropResultMove",
					"value": "1<<2",
					"type": "int",
					"expression": true,
					"brief": "drop causes move"
				}
			]
		},
		{
			"name": "OrientationType",
