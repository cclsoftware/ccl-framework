<?xml version="1.0" encoding="UTF-8"?>
<Model.ClassRepository xmlns:x="https://ccl.dev/xml" name="Visual Styles">
	<List x:id="classes">
		<Model.Class name="TestButton">
			<List x:id="members">
				<Model.Member name="highlightColor" type="void">
					<Model.Documentation x:id="doc">
						<String x:id="brief" text="Color used to highlight the button"/>
					</Model.Documentation>
				</Model.Member>
				<Model.Member name="spacing" type="void">
					<Model.Documentation x:id="doc">
						<String x:id="brief" text="Spacing between button elements"/>
					</Model.Documentation>
				</Model.Member>
				<Model.Member name="outline" type="void">
					<Model.Documentation x:id="doc">
						<String x:id="brief" text="Outline color of the button"/>
					</Model.Documentation>
				</Model.Member>
			</List>
		</Model.Class>
	</List>
</Model.ClassRepository>
