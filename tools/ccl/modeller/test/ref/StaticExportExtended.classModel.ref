<?xml version="1.0" encoding="UTF-8"?>
<Model.ClassRepository xmlns:x="https://ccl.dev/xml" name="staticexport_extended">
	<List x:id="classes">
		<Model.Class name="CommentedPersistentClass" parent="Object">
		</Model.Class>
		<Model.Class name="InterfaceList" scriptable="1" parent="Object">
			<List x:id="members">
				<Model.Member name="ISomeInterface" type="object" typeName="UID" readOnly="1"/>
			</List>
		</Model.Class>
		<Model.Class name="MultiFileClass" scriptable="1" parent="Object">
			<List x:id="members">
				<Model.Member name="bar" type="void"/>
			</List>
		</Model.Class>
		<Model.Class name="NestedArgsClass" scriptable="1" parent="Object">
			<List x:id="members">
				<Model.Member name="nested" type="object" typeName="SomeTemplate (Foo, Bar)"/>
			</List>
		</Model.Class>
		<Model.Class name="PersistentSubClass" parent="StoredPersistentClass">
		</Model.Class>
		<Model.Class name="StoredPersistentClass" parent="Object">
		</Model.Class>
	</List>
</Model.ClassRepository>
