		<Model.Class name="Url" namespace="CCL" scriptable="1" parent="Object" parentNamespace="CCL">
			<List x:id="members">
				<Model.Member name="name" type="void"/>
				<Model.Member name="url" type="void"/>
				<Model.Member name="extension" type="void"/>
				<Model.Member name="protocol" type="void"/>
				<Model.Member name="hostname" type="void"/>
			</List>
			<List x:id="methods">
				<Model.Method name="ascend">
					<Model.ReturnValue x:id="retval" type="void"/>
				</Model.Method>
				<Model.Method name="descend">
					<Model.ReturnValue x:id="retval" type="void"/>
					<List x:id="args">
						<Model.MethodArg name="name" type="void"/>
						<Model.MethodArg name="folder" type="void" defaultValue="false"/>
					</List>
				</Model.Method>
				<Model.Method name="makeUnique">
					<Model.ReturnValue x:id="retval" type="void"/>
					<List x:id="args">
						<Model.MethodArg name="forceSuffix" type="void" defaultValue="false"/>
					</List>
				</Model.Method>
				<Model.Method name="toDisplayString">
					<Model.ReturnValue x:id="retval" type="string"/>
				</Model.Method>
				<Model.Method name="fromDisplayString">
					<Model.ReturnValue x:id="retval" type="void"/>
					<List x:id="args">
						<Model.MethodArg name="string" type="void"/>
						<Model.MethodArg name="folder" type="void" defaultValue="false"/>
					</List>
				</Model.Method>
				<Model.Method name="contains">
					<Model.ReturnValue x:id="retval" type="void"/>
					<List x:id="args">
						<Model.MethodArg name="childUrl" type="object" typeName="Url"/>
					</List>
